Import("env")

env.Append(
    LINT_SOURCES=[
        Dir("."),
    ]
)


libenv = env.Clone(FW_LIB_NAME="furi")
libenv.ApplyLibFlags()

sources = []
for src in libenv.GlobRecursive("*.c"):
    if str(src).replace("\\", "/").endswith(tuple(libenv.get("NO_LTO_SOURCES", ()))):
        # See scripts/fbt/lto.py: link-time optimization breaks its inline asm.
        sources.append(
            libenv.StaticObject(src, CCFLAGS=libenv["CCFLAGS"] + ["-fno-lto"])
        )
    else:
        sources.append(src)

lib = libenv.StaticLibrary("${FW_LIB_NAME}", sources)
libenv.Install("${LIB_DIST_DIR}", lib)
Return("lib")
